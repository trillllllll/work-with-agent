{
  "name": "dovun",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "prisma:generate": "npm run prisma:generate -w server",
    "test": "node scripts/test.mjs",
    "test:all": "npm test && npm run e2e",
    "db:migrate": "npm run db:migrate -w server",
    "e2e": "playwright test",
    "e2e:orchestration": "playwright test -c playwright.orchestration.config.ts",
    "test:library:migration": "tsx scripts/library-migration.ts",
    "test:library:performance": "tsx scripts/library-performance.ts",
    "e2e:real": "node e2e/run-real.mjs",
    "db:backup": "node scripts/backup.mjs",
    "desktop:assemble": "node scripts/assemble-desktop.mjs",
    "desktop:dev": "node scripts/assemble-desktop.mjs && node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/assemble-desktop.mjs && node scripts/tauri.mjs build",
    "desktop:build:windows": "node scripts/assemble-desktop.mjs && node scripts/tauri.mjs build --bundles nsis",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "controls:check": "node scripts/design-tokens.mjs --check && node scripts/check-control-reuse.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.5",
    "concurrently": "^9.1.2"
  }
}
