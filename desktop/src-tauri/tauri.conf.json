{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dovun",
  "version": "0.5.1",
  "identifier": "app.dovun.desktop",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:47111",
    "beforeDevCommand": "node ../../scripts/splash-server.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dovun",
        "width": 1200,
        "height": 800,
        "minWidth": 578,
        "minHeight": 640,
        "resizable": true,
        "url": "index.html",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../resources/node.exe": "node.exe",
      "../resources/server/": "server/",
      "../resources/client/": "client/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  }
}
