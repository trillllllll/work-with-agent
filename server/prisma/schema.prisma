generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id            String   @id
  openaiBaseUrl String   @default("") @map("openai_base_url")
  openaiApiKey  String   @default("") @map("openai_api_key")
  openaiModel   String   @default("") @map("openai_model")
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")

  @@map("app_settings")
}

enum TaskStatus {
  todo
  doing
  blocked
  done
}

enum TaskPriority {
  none
  low
  medium
  high
}

model Topic {
  id            String   @id @default(cuid()) @map("id")
  name          String
  description   String   @default("")
  isExploration Boolean  @default(false) @map("is_exploration")
  goal          String     @default("")
  draftSummary  String     @default("") @map("draft_summary")
  finalSummary  String     @default("") @map("final_summary")
  summaryStatus String     @default("empty") @map("summary_status")
  summaryUpdatedAt String? @map("summary_updated_at")
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")
  tasks         Task[]

  @@map("topics")
}

model Task {
  id            String     @id @default(cuid())
  topicId       String?    @map("topic_id")
  title         String
  description   String     @default("")
  status        TaskStatus @default(todo)
  priority      TaskPriority @default(none)
  dueDate       String?    @map("due_date")
  resultSummary String     @default("") @map("result_summary")
  deletedAt String? @map("deleted_at")
  createdAt     String     @default("") @map("created_at")
  updatedAt     String     @default("") @map("updated_at")
  topic         Topic?     @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@index([topicId])
  @@index([topicId, deletedAt])
  @@index([deletedAt])
  @@map("tasks")
}

enum MessageRole {
  user
  assistant
  tool
  system
}

enum MessageStatus {
  streaming
  completed
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

model Conversation {
  id        String    @id @default(cuid())
  summary   String    @default("")
  summaryVersion Int   @default(0) @map("summary_version")
  lastCompactedAt String? @map("last_compacted_at")
  tokenEstimate Int   @default(0) @map("token_estimate")
  createdAt String    @default("") @map("created_at")
  updatedAt String    @default("") @map("updated_at")
  messages  Message[]
  approvals Approval[]

  @@map("conversations")
}

model ChangeRecord {
  id String @id @default(cuid())
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  operation String
  beforeSnapshot String? @map("before_snapshot")
  afterSnapshot String? @map("after_snapshot")
  source String
  conversationId String? @map("conversation_id")
  approvalId String? @map("approval_id")
  requestId String? @map("request_id")
  reversalOf String? @map("reversal_of")
  undoneAt String? @map("undone_at")
  createdAt String @default("") @map("created_at")
  @@index([entityType, entityId, createdAt])
  @@map("change_records")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  content        String
  status         MessageStatus @default(completed)
  compactedAt    String?       @map("compacted_at")
  createdAt      String       @default("") @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Approval {
  id        String         @id @default(cuid())
  conversationId String?   @map("conversation_id")
  toolName  String         @map("tool_name")
  arguments String
  status    ApprovalStatus @default(pending)
  result    String?
  createdAt String         @default("") @map("created_at")
  updatedAt String         @default("") @map("updated_at")
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("approvals")
}
