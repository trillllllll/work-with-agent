generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSetting {
  braveImageApiKey String @default("") @map("brave_image_api_key")
  id            String   @id
  openaiBaseUrl String   @default("") @map("openai_base_url")
  openaiApiKey  String   @default("") @map("openai_api_key")
  openaiModel   String   @default("") @map("openai_model")
  replyStyle    String   @default("结论先行，多用短句。") @map("reply_style")
  codexManualCommand String @default("") @map("codex_manual_command")
  codexAutoCommand String @default("") @map("codex_auto_command")
  codexAutoVersion String @default("") @map("codex_auto_version")
  codexManualVersion String @default("") @map("codex_manual_version")
  codexCheckedAt String @default("") @map("codex_checked_at")
  claudeManualCommand String @default("") @map("claude_manual_command")
  claudeAutoCommand String @default("") @map("claude_auto_command")
  claudeAutoVersion String @default("") @map("claude_auto_version")
  claudeManualVersion String @default("") @map("claude_manual_version")
  claudeCheckedAt String @default("") @map("claude_checked_at")
  mobileNavigationJson String @default("[\"inbox\",\"today\",\"quadrant\",\"topics\"]") @map("mobile_navigation_json")
  htmlBlocksEnabled Boolean @default(true) @map("html_blocks_enabled")
  htmlCdnAllowlist String @default("[\"https://cdn.jsdelivr.net\",\"https://cdnjs.cloudflare.com\",\"https://unpkg.com\"]") @map("html_cdn_allowlist")
  assistantIdentityJson String @default("{}") @map("assistant_identity_json")
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")

  @@map("app_settings")
}

enum TaskStatus {
  todo
  doing
  blocked
  done
}

enum TaskPriority {
  none
  low
  medium
  high
}

model Topic {
  id            String   @id @default(cuid()) @map("id")
  name          String
  description   String   @default("")
  color         String   @default("slate")
  isExploration Boolean  @default(false) @map("is_exploration")
  goal          String     @default("")
  goalDueDate   String?    @map("goal_due_date")
  draftSummary  String     @default("") @map("draft_summary")
  finalSummary  String     @default("") @map("final_summary")
  summaryStatus String     @default("empty") @map("summary_status")
  summaryUpdatedAt String? @map("summary_updated_at")
  archivedAt    String?  @map("archived_at")
  revision      Int      @default(1)
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")
  tasks         Task[]
  assignmentsFrom TaskTopicAssignment[] @relation("AssignmentFromTopic")
  assignmentsTo   TaskTopicAssignment[] @relation("AssignmentToTopic")

  @@map("topics")
}

model Task {
  id            String     @id @default(cuid())
  topicId       String?    @map("topic_id")
  parentId      String?    @map("parent_id")
  sortOrder     Int        @default(0) @map("sort_order")
  revision      Int        @default(1)
  deleteBatchId String?    @map("delete_batch_id")
  title         String
  description   String     @default("")
  status        TaskStatus @default(todo)
  priority      TaskPriority @default(none)
  dueDate       String?    @map("due_date")
  estimatedMinutes Int?    @map("estimated_minutes")
  scheduledStart String?   @map("scheduled_start")
  scheduledEnd   String?   @map("scheduled_end")
  resultSummary String     @default("") @map("result_summary")
  recurrenceRule String    @default("") @map("recurrence_rule")
  deletedAt String? @map("deleted_at")
  createdAt     String     @default("") @map("created_at")
  updatedAt     String     @default("") @map("updated_at")
  completedAt   String?    @map("completed_at")
  completedAtEstimated Boolean @default(false) @map("completed_at_estimated")
  topic         Topic?     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  parent        Task?      @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children      Task[]     @relation("TaskChildren")
  tags          TaskTag[]
  focusSessions FocusSession[]
  topicAssignments TaskTopicAssignment[]
  materialLinks MaterialTaskLink[]

  @@index([topicId])
  @@index([topicId, deletedAt])
  @@index([deletedAt])
  @@index([topicId, parentId, deletedAt, sortOrder])
  @@index([parentId])
  @@index([deleteBatchId])
  @@index([completedAt])
  @@index([createdAt])
  @@map("tasks")
}

model Tag {
  id        String @id @default(cuid())
  name      String
  color     String @default("violet")
  revision  Int    @default(1)
  createdAt String @default("") @map("created_at")
  updatedAt String @default("") @map("updated_at")
  tasks     TaskTag[]

  @@map("tags")
}

model FocusSession {
  id              String  @id @default(cuid())
  taskId          String? @map("task_id")
  kind            String  @default("focus")
  startedAt       String  @map("started_at")
  endedAt         String  @map("ended_at")
  durationMinutes Int     @map("duration_minutes")
  plannedMinutes  Int     @default(25) @map("planned_minutes")
  completed       Boolean @default(true)
  createdAt       String  @default("") @map("created_at")
  task            Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([startedAt])
  @@map("focus_sessions")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model TaskImage {
  id        String @id @default(cuid())
  taskId    String @map("task_id")
  mimeType  String @map("mime_type")
  byteSize  Int    @map("byte_size")
  path      String
  createdAt String @default("") @map("created_at")

  @@index([taskId])
  @@map("task_images")
}

model TaskTopicAssignment {
  id             String  @id @default(cuid())
  taskId         String  @map("task_id")
  fromTopicId    String? @map("from_topic_id")
  toTopicId      String? @map("to_topic_id")
  reason         String
  source         String
  conversationId String? @map("conversation_id")
  approvalId     String? @map("approval_id")
  changedAt      String  @default("") @map("changed_at")
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromTopic      Topic?  @relation("AssignmentFromTopic", fields: [fromTopicId], references: [id], onDelete: Restrict)
  toTopic        Topic?  @relation("AssignmentToTopic", fields: [toTopicId], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
  @@index([fromTopicId])
  @@index([toTopicId])
  @@map("task_topic_assignments")
}

enum MessageRole {
  user
  assistant
  tool
  system
}

enum MessageStatus {
  streaming
  completed
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

model Conversation {
  id        String    @id @default(cuid())
  identityId String   @default("work") @map("identity_id")
  summary   String    @default("")
  summaryVersion Int   @default(0) @map("summary_version")
  lastCompactedAt String? @map("last_compacted_at")
  tokenEstimate Int   @default(0) @map("token_estimate")
  createdAt String    @default("") @map("created_at")
  updatedAt String    @default("") @map("updated_at")
  activeRunId String? @map("active_run_id")
  messages  Message[]
  approvals Approval[]
  agentRuns AgentRun[]

  @@index([identityId])
  @@map("conversations")
}

model ChangeRecord {
  id String @id @default(cuid())
  actorId String? @map("actor_id")
  connectionId String? @map("connection_id")
  proposalId String? @map("proposal_id")
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  entityName String? @map("entity_name")
  operation String
  beforeSnapshot String? @map("before_snapshot")
  afterSnapshot String? @map("after_snapshot")
  source String
  conversationId String? @map("conversation_id")
  approvalId String? @map("approval_id")
  requestId String? @map("request_id")
  reversalOf String? @map("reversal_of")
  undoneAt String? @map("undone_at")
  approvedByActorId String? @map("approved_by_actor_id")
  createdAt String @default("") @map("created_at")
  @@index([entityType, entityId, createdAt])
  @@index([connectionId, createdAt])
  @@index([createdAt, connectionId])
  @@index([createdAt, id])
  @@index([entityId])
  @@map("change_records")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  content        String
  status         MessageStatus @default(completed)
  toolCalls      String?      @map("tool_calls")
  toolCallId     String?      @map("tool_call_id")
  compactedAt    String?       @map("compacted_at")
  blocksJson     String?      @map("blocks_json")
  partsJson      String       @default("[]") @map("parts_json")
  createdAt      String       @default("") @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Approval {
  id        String         @id @default(cuid())
  conversationId String?   @map("conversation_id")
  toolName  String         @map("tool_name")
  arguments String
  status    ApprovalStatus @default(pending)
  result    String?
  runId     String?        @map("run_id")
  decisionToken String?    @map("decision_token")
  decisionExpiresAt String? @map("decision_expires_at")
  createdAt String         @default("") @map("created_at")
  updatedAt String         @default("") @map("updated_at")
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  run       AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([runId])
  @@map("approvals")
}

model AgentRun {
  id                  String   @id @default(cuid())
  conversationId      String   @map("conversation_id")
  sourceUserMessageId String   @unique @map("source_user_message_id")
  requestKey          String   @unique @map("request_key")
  requestHash         String   @map("request_hash")
  state               String   @default("queued")
  pauseReason         String?  @map("pause_reason")
  contextJson         String   @map("context_json")
  modelMessagesJson   String   @map("model_messages_json")
  cursorJson          String   @map("cursor_json")
  nextEventSeq        Int      @default(0) @map("next_event_seq")
  leaseToken          String?  @map("lease_token")
  leaseExpiresAt      String?  @map("lease_expires_at")
  errorCode           String?  @map("error_code")
  errorMessage        String?  @map("error_message")
  createdAt           String   @map("created_at")
  updatedAt           String   @map("updated_at")
  completedAt         String?  @map("completed_at")
  inputTokens         Int?     @map("input_tokens")
  cachedInputTokens   Int?     @map("cached_input_tokens")
  outputTokens        Int?     @map("output_tokens")
  model               String?
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvals           Approval[]
  events              AgentRunEvent[]

  @@index([state, updatedAt])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

model AgentRunEvent {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  seq       Int
  type      String
  dataJson  String   @map("data_json")
  createdAt String   @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("agent_run_events")
}

model LocalSession {
  id String @id
  tokenHash String @unique
  csrfHash String
  expiresAt String
  createdAt String
}

model Connection {
  id String @id @default(cuid())
  name String
  host String
  tokenHash String @unique
  status String @default("active")
  topicIds String @default("[]")
  includeInbox Boolean @default(false)
  autoActions String @default("[]")
  revision Int @default(1)
  createdAt String
  updatedAt String
  lastUsedAt String? @map("last_used_at")
  @@index([status, createdAt])
}

model Proposal {
  id String @id @default(cuid())
  actorId String
  connectionId String?
  revision Int @default(1)
  status String @default("pending")
  commands String
  preconditions String
  preview String
  result String?
  createdAt String
  updatedAt String
  @@index([status, createdAt])
  @@index([actorId, createdAt])
}

model RequestReceipt {
  id String @id @default(cuid())
  actorId String
  requestId String
  requestHash String
  response String
  createdAt String
  @@unique([actorId, requestId])
}

model Material {
  id String @id @default(cuid())
  topicId String?
  taskId String?
  kind String
  title String
  uri String?
  revision Int @default(1)
  archivedAt String?
  createdAt String
  updatedAt String
  folderId String?
  organizationRevision Int @default(1)
  versions MaterialVersion[]
  folder LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  tags MaterialTag[]
  taskLinks MaterialTaskLink[]
  @@index([topicId, archivedAt, updatedAt])
  @@index([taskId])
  @@index([folderId, archivedAt, updatedAt])
}
model MaterialVersion {
  id String @id @default(cuid())
  materialId String
  revision Int
  content String @default("")
  contentHash String
  metadata String @default("{}")
  attachmentPath String?
  mimeType String?
  fileName String?
  createdAt String
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  extractions MaterialExtraction[]
  searchDocuments LibrarySearchDocument[]
  @@unique([materialId, revision])
}
model Memory {
  id String @id @default(cuid())
  identityId String @default("work") @map("identity_id")
  topicId String?
  kind String
  title String
  content String
  status String @default("active")
  health String @default("current")
  importance Int @default(3)
  labels String @default("[]")
  origin String @default("manual")
  revision Int @default(1)
  evidence String @default("[]")
  createdAt String
  updatedAt String
  versions MemoryVersion[]
  @@index([topicId, status, importance, updatedAt])
  @@index([identityId])
}
model MemoryVersion {
  id String @id @default(cuid())
  memoryId String
  revision Int
  title String
  content String
  kind String
  status String
  health String
  evidence String
  importance Int @default(3)
  labels String @default("[]")
  origin String @default("manual")
  reason String
  createdAt String
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  @@unique([memoryId, revision])
}
model Entity {
  id String @id @default(cuid())
  topicKey String
  topicId String?
  name String
  kind String @default("concept")
  description String @default("")
  revision Int @default(1)
  createdAt String
  updatedAt String
  @@unique([topicKey, name])
  @@index([topicId, kind])
}
model GraphLink {
  id String @id @default(cuid())
  topicId String?
  fromType String
  fromId String
  toType String
  toId String
  relation String
  note String @default("")
  createdAt String
  @@unique([fromType, fromId, toType, toId, relation])
  @@index([fromId, fromType])
  @@index([toId, toType])
}
model WorkingBrief {
  id String @id @default(cuid())
  topicId String?
  content String @default("")
  manualNotes String @default("")
  manifest String @default("[]")
  revision Int @default(1)
  generatedAt String?
  updatedAt String
  @@index([topicId])
}
model OrganizationRequest {
  id String @id @default(cuid())
  topicId String?
  purpose String
  provider String
  status String @default("pending")
  snapshot String
  proposalIds String @default("[]")
  result String?
  error String?
  createdAt String
  updatedAt String
  @@index([topicId, status, createdAt])
}
model ReviewRule {
  id String @id @default(cuid())
  name String
  enabled Boolean @default(false)
  frequency String
  timeOfDay String
  timeZone String
  weekDay Int @default(0)
  topicIds String @default("[]")
  includeInbox Boolean @default(false)
  provider String @default("none")
  revision Int @default(1)
  coverageThrough String?
  createdAt String
  updatedAt String
  deletedAt String?
  batches ReviewBatch[]
}
model ReviewBatch {
  id String @id @default(cuid())
  ruleId String
  occurrenceKey String
  status String @default("generating")
  snapshot String @default("{}")
  content String @default("")
  organizationIds String @default("[]")
  error String?
  createdAt String
  updatedAt String
  rule ReviewRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  @@unique([ruleId, occurrenceKey])
}

model Handoff {
  id String @id @default(cuid())
  taskId String
  status String @default("prepared")
  provider String
  mode String @default("manual")
  instruction String
  inputSnapshot String
  inputHash String
  permissions String @default("{}")
  revision Int @default(1)
  createdBy String @default("user")
  createdAt String
  updatedAt String
  runs Run[]
  reviews HandoffReview[]
  @@index([taskId, createdAt])
}
model Run {
  id String @id @default(cuid())
  handoffId String
  continuationOf String?
  status String @default("created")
  provider String
  mode String
  externalSessionId String?
  claimTokenHash String?
  claimOwner String?
  configJson String @default("{}")
  workspaceJson String @default("{}")
  resultJson String?
  error String?
  lastSequence Int @default(0)
  startedAt String?
  endedAt String?
  exitCode Int?
  cliVersion String?
  model String?
  inputTokens Int?
  cachedInputTokens Int?
  outputTokens Int?
  costMicroUsd Int?
  numTurns Int?
  cliDurationMs Int?
  runDurationMs Int?
  usageJson String?
  createdAt String
  updatedAt String
  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  events RunEvent[]
  artifacts Artifact[]
  @@index([status, createdAt])
}
model RunEvent {
  id String @id @default(cuid())
  runId String
  eventId String?
  sequence Int
  type String
  payload String
  createdAt String
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@unique([runId, sequence])
  @@unique([runId, eventId])
}
model Artifact {
  id String @id @default(cuid())
  runId String
  kind String
  name String
  content String?
  path String?
  hash String
  metadata String @default("{}")
  createdAt String
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@index([runId])
}

// ---- Orchestration: the server only plans and checks; local executors (wwa-node) do the work.
model AgentNode {
  id               String  @id @default(cuid())
  name             String
  tokenHash        String  @unique
  status           String  @default("active")
  platform         String  @default("")
  version          String  @default("")
  capabilitiesJson String  @default("{}")
  inventoryJson    String  @default("null")
  inventoryAt      String?
  lastSeenAt       String?
  createdAt        String
  updatedAt        String
  deletedAt        String?
  locations        ProjectLocation[]
  jobs             NodeJob[]
}
model Project {
  id              String  @id @default(cuid())
  name            String
  defaultBranch   String  @default("main")
  defaultProvider String  @default("codex")
  defaultParallel Int     @default(2)
  archivedAt      String?
  revision        Int     @default(1)
  createdAt       String
  updatedAt       String
  locations       ProjectLocation[]
  bindings        ProjectBinding[]
}
model ProjectLocation {
  id              String  @id @default(cuid())
  projectId       String
  nodeId          String
  path            String
  status          String  @default("pending")
  fingerprintJson String  @default("{}")
  error           String?
  verifiedAt      String?
  createdAt       String
  updatedAt       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  node            AgentNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@unique([projectId, nodeId])
}
model ProjectBinding {
  scopeType String
  scopeId   String
  projectId String
  updatedAt String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@id([scopeType, scopeId])
}
model Orchestration {
  id                String  @id @default(cuid())
  taskId            String
  round             Int
  status            String  @default("draft")
  projectId         String
  locationId        String?
  nodeId            String?
  repoPath          String  @default("")
  defaultBranch     String  @default("main")
  integrationBranch String
  integrationPath   String?
  baseCommit        String?
  integrationHead   String?
  grantJson         String  @default("{}")
  planJson          String  @default("{}")
  taskSnapshotJson  String  @default("{}")
  pauseReason       String?
  finalComment      String?
  revision          Int     @default(1)
  createdAt         String
  updatedAt         String
  startedAt         String?
  endedAt           String?
  acceptedAt        String?
  acceptanceNote    String?
  rejectionReason   String?
  rejectedAt        String?
  pushedAt          String?
  extraLocationsJson String @default("[]")
  publishedHead     String?
  pullRequestUrl    String?
  steps             OrchestrationStep[]
  events            OrchestrationEvent[]
  @@unique([taskId, round])
  @@index([status])
  @@index([projectId, startedAt])
}
model OrchestrationStep {
  id                 String  @id @default(cuid())
  orchestrationId    String
  kind               String
  subtaskId          String?
  sourceStepId       String?
  dependsOnJson      String  @default("[]")
  position           Int
  status             String  @default("pending")
  attempt            Int     @default(1)
  continueCount      Int     @default(0)
  retryCount         Int     @default(0)
  nextAttemptAt      String?
  branch             String?
  workPath           String?
  baseCommit         String?
  resultCommit       String?
  preMergeHead       String?
  mergeCommit        String?
  acceptanceCriteria String  @default("")
  lastTaskRevision   Int?
  feedback           String?
  lastJobId          String?
  nodeId             String?
  locationId         String?
  repoPath           String?
  error              String?
  failureKind        String?
  createdAt          String
  updatedAt          String
  orchestration      Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Restrict)
  @@index([orchestrationId, status])
}
model NodeJob {
  id              String  @id @default(cuid())
  nodeId          String
  orchestrationId String?
  stepId          String?
  kind            String
  phase           String  @default("work")
  dispatchKey     String  @unique
  status          String  @default("queued")
  payloadJson     String
  leaseToken      String?
  leaseExpiresAt  String?
  resultJson      String?
  error           String?
  createdAt       String
  updatedAt       String
  startedAt         String?
  endedAt           String?
  exitCode          Int?
  provider          String?
  cliVersion        String?
  model             String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  costMicroUsd      Int?
  numTurns          Int?
  cliDurationMs     Int?
  runDurationMs     Int?
  usageJson         String?
  filesChanged      Int?
  linesAdded        Int?
  linesDeleted      Int?
  diffStatJson      String?
  failureKind       String?
  node              AgentNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@index([nodeId, status])
  @@index([orchestrationId])
  @@index([endedAt])
}
/// A pending destructive request shown as a confirmation card; nothing is sent to the node until the user confirms.
model WorktreeCleanup {
  id          String  @id @default(cuid())
  nodeId      String
  itemsJson   String
  deleteBranches Boolean @default(false)
  status      String  @default("pending")
  source      String  @default("user")
  jobId       String?
  resultJson  String?
  expiresAt   String
  createdAt   String
  updatedAt   String
  @@index([nodeId, status])
}
model OrchestrationEvent {
  id              String @id @default(cuid())
  orchestrationId String
  seq             Int
  type            String
  actorKind       String
  stepId          String?
  payload         String
  createdAt       String
  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Restrict)
  @@unique([orchestrationId, seq])
}
model HandoffReview {
  id String @id @default(cuid())
  handoffId String
  runId String
  decision String
  comment String @default("")
  taskRevision Int
  createdAt String
  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  @@index([handoffId])
}
model CodeApplication {
  id String @id @default(cuid())
  runId String
  artifactId String
  status String @default("prepared")
  targetPath String
  expectedHead String
  details String @default("{}")
  createdAt String
  updatedAt String
  @@index([runId])
}

model LibraryFolder {
  id String @id
  parentId String?
  name String
  normalizedName String
  revision Int @default(1)
  createdAt String
  updatedAt String
  parent LibraryFolder? @relation("LibraryFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children LibraryFolder[] @relation("LibraryFolderTree")
  materials Material[]
  @@index([parentId])
}

model LibraryTag {
  id String @id
  name String
  normalizedName String @unique
  revision Int @default(1)
  createdAt String
  updatedAt String
  materials MaterialTag[]
}

model MaterialTag {
  materialId String
  tagId String
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag LibraryTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  @@id([materialId, tagId])
  @@index([tagId, materialId])
}

model MaterialTaskLink {
  materialId String
  taskId String
  manual Boolean @default(false)
  legacy Boolean @default(false)
  createdAt String
  createdBy String
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@id([materialId, taskId])
  @@index([taskId, materialId])
}

model LibraryUpload {
  id String @id
  actorId String
  requestKey String
  fileName String
  mimeType String
  declaredSize Int
  actualSize Int?
  sha256 String?
  state String @default("pending")
  leaseToken String?
  receiveLeaseUntil String?
  contentKey String?
  commitRequestHash String?
  commitResultJson String?
  materialId String?
  resultRevision Int?
  errorCode String?
  createdAt String
  updatedAt String
  expiresAt String
  @@unique([actorId, requestKey])
  @@index([state, expiresAt])
  @@index([state, receiveLeaseUntil], map: "LibraryUpload_receiveLease")
}

model MaterialExtraction {
  id String @id
  materialId String
  revision Int
  parserVersion String @default("library-v1")
  status String @default("queued")
  generation Int @default(0)
  indexedGeneration Int @default(0)
  attempts Int @default(0)
  leaseToken String?
  leaseUntil String?
  nextAttemptAt String
  errorCode String?
  errorsJson String @default("[]")
  createdAt String
  updatedAt String
  version MaterialVersion @relation(fields: [materialId, revision], references: [materialId, revision], onDelete: Cascade)
  chunks MaterialChunk[]
  @@unique([materialId, revision])
  @@index([status, nextAttemptAt, leaseUntil])
}

model MaterialChunk {
  id String @id
  extractionId String
  generation Int
  ordinal Int
  text String
  textHash String
  locatorJson String
  method String
  createdAt String
  extraction MaterialExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  searchDocuments LibrarySearchDocument[]
  @@unique([extractionId, generation, ordinal])
}

model LibrarySearchDocument {
  id String @id
  materialId String
  revision Int
  chunkId String?
  titleNorm String
  fileNameNorm String
  tagsNorm String
  bodyNorm String
  normalizationMapJson String @default("[]")
  version MaterialVersion @relation(fields: [materialId, revision], references: [materialId, revision], onDelete: Cascade)
  chunk MaterialChunk? @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  postings LibrarySearchPosting[]
  normMap LibrarySearchNormMap?
  @@index([materialId, revision])
}

model LibrarySearchNormMap {
  documentId String @id
  normalizationMapJson String
  document LibrarySearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model LibrarySearchPosting {
  token String
  documentId String
  materialId String
  document LibrarySearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@id([token, documentId])
  @@index([documentId])
}

model LibraryAnswer {
  id String @id
  actorId String
  requestKey String
  question String
  filtersJson String
  status String
  resultJson String
  createdAt String
  @@unique([actorId, requestKey])
}

model PlanTimeBand {
  id           String @id
  name         String
  startMinute  Int    @map("start_minute")
  endMinute    Int    @map("end_minute")
  weekdaysJson String @map("weekdays_json")
  color        String
  position     Int

  @@map("plan_time_bands")
}

model AutoMemoryScope {
  id              String  @id
  topicId         String?
  enabled         Boolean @default(true)
  revision        Int     @default(1)
  initializedAt   String?
  dirtySince      String?
  dueAt           String?
  lastStartedAt   String?
  lastCompletedAt String?
  createdAt       String
  updatedAt       String
}

model AutoMemorySource {
  id              String  @id
  scopeKey        String
  sourceType      String
  sourceId        String
  part            Int
  revision        Int
  observedHash    String
  processedHash   String?
  failedHash      String?
  formatRecoveryVersion Int @default(0)
  available       Boolean @default(true)
  firstObservedAt String
  changedAt       String
  updatedAt       String

  @@unique([scopeKey, sourceType, sourceId, part])
  @@index([scopeKey, available, changedAt])
}

model AutoMemoryJob {
  id             String  @id @default(cuid())
  scopeKey       String
  inputHash      String
  attempt        Int     @default(1)
  status         String  @default("queued")
  snapshot       String
  modelOutput    String?
  requestedModel String?
  responseModel  String?
  modelFinishReason String?
  provider       String?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  usageStatus    String @default("legacy")
  reusedFromJobId String?
  proposalIds    String  @default("[]")
  leaseToken     String?
  leaseExpiresAt String?
  errorCode      String?
  errorMessage   String?
  createdAt      String
  startedAt      String?
  completedAt    String?

  @@unique([scopeKey, inputHash, attempt])
  @@index([status, createdAt])
  @@index([provider, requestedModel, createdAt])
}

model AutoMemoryTurn {
  id                  String  @id
  conversationId      String
  topicId             String?
  userMessageId       String  @unique
  assistantMessageIds String  @default("[]")
  status              String  @default("collecting")
  materialIds         String  @default("[]")
  createdAt           String
  completedAt         String?

  @@index([status, createdAt])
}

model MemorySuggestionKey {
  id         String @id
  scopeKey   String
  proposalId String
  createdAt  String

  @@index([scopeKey, proposalId])
}

model Skill {
  id           String         @id @default(cuid())
  identityId   String         @default("work") @map("identity_id")
  name         String
  description  String
  instructions String
  enabled      Boolean        @default(false)
  revision     Int            @default(1)
  origin       String         @default("manual")
  deletedAt    String?
  createdAt    String
  updatedAt    String
  versions     SkillVersion[]

  @@index([deletedAt, enabled, name])
  @@index([identityId])
}

model LearningMap {
  id        String   @id @default(cuid())
  title     String
  goal      String   @default("")
  status    String   @default("active")
  sortOrder Int      @default(0) @map("sort_order")
  revision  Int      @default(1)
  deletedAt String?  @map("deleted_at")
  createdAt String   @default("") @map("created_at")
  updatedAt String   @default("") @map("updated_at")
  nodes        LearningNode[]
  activities   LearningActivity[]

  @@index([deletedAt, status, sortOrder])
  @@map("learning_maps")
}

model LearningNode {
  id        String   @id @default(cuid())
  mapId     String   @map("map_id")
  parentId  String?  @map("parent_id")
  kind      String   @default("topic")
  title     String
  detail    String   @default("")
  status    String   @default("todo")
  mastery   Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  revision  Int      @default(1)
  deletedAt String?  @map("deleted_at")
  createdAt String   @default("") @map("created_at")
  updatedAt String   @default("") @map("updated_at")
  map          LearningMap      @relation(fields: [mapId], references: [id], onDelete: Restrict)
  parent       LearningNode?    @relation("LearningChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children     LearningNode[]   @relation("LearningChildren")
  activities   LearningActivity[]

  @@index([mapId])
  @@index([mapId, deletedAt, sortOrder])
  @@index([parentId])
  @@index([deletedAt])
  @@map("learning_nodes")
}

model LearningActivity {
  id        String   @id @default(cuid())
  mapId     String   @map("map_id")
  nodeId    String?  @map("node_id")
  kind      String
  content   String
  metaJson  String   @default("{}") @map("meta_json")
  createdAt String   @default("") @map("created_at")
  map        LearningMap   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node       LearningNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([mapId, createdAt])
  @@map("learning_activity")
}

model SkillVersion {
  id           String  @id @default(cuid())
  skillId      String
  revision     Int
  name         String
  description  String
  instructions String
  enabled      Boolean
  reason       String
  source       String
  createdAt    String
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([skillId, revision])
}

/// Ordered hub log for task, topic, and tag alignment. Seq is assigned only on the server.
model SyncOp {
  seq        Int     @id @default(autoincrement())
  opId       String  @unique @map("op_id")
  deviceId   String  @default("server") @map("device_id")
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  beforeJson String? @map("before_json")
  afterJson  String? @map("after_json")
  revision   Int     @default(0)
  createdAt  String  @default("") @map("created_at")

  @@index([entityType, entityId])
  @@map("sync_ops")
}

model SyncDevice {
  id         String @id
  name       String @default("")
  tokenHash  String @unique @map("token_hash")
  lastSeenAt String @default("") @map("last_seen_at")
  createdAt  String @default("") @map("created_at")

  @@map("sync_devices")
}

model SyncWorkspace {
  id          String @id
  workspaceId String @unique @map("workspace_id")
  createdAt   String @map("created_at")

  @@map("sync_workspace")
}

/// Immutable request receipts, including conflicts and no-op writes. Stored with the business write.
model SyncReceipt {
  opId        String @id @map("op_id")
  requestHash String @map("request_hash")
  resultJson  String @map("result_json")
  createdAt   String @map("created_at")

  @@map("sync_receipts")
}

model SyncConflict {
  id           String  @id @default(cuid())
  opId         String  @map("op_id")
  deviceId     String  @map("device_id")
  entityType   String  @map("entity_type")
  entityId     String  @map("entity_id")
  field        String
  baseJson     String  @map("base_json")
  liveJson     String  @map("live_json")
  incomingJson String  @map("incoming_json")
  state        String  @default("pending")
  createdAt    String  @default("") @map("created_at")
  resolvedAt   String? @map("resolved_at")

  @@index([state, createdAt])
  @@map("sync_conflicts")
}

/// Replica-only queue. The hub never reads this table. Acked rows stay for idempotent opIds.
model SyncOutbox {
  seq        Int     @id @default(autoincrement())
  opId       String  @unique @map("op_id")
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  beforeJson String? @map("before_json")
  afterJson  String? @map("after_json")
  state      String  @default("pending")
  createdAt  String  @default("") @map("created_at")

  @@index([state, seq])
  @@map("sync_outbox")
}

/// One row, id = local. Incremental sync stays off until the first id alignment finishes.
model SyncState {
  id             String  @id
  appliedHubSeq  Int     @default(0) @map("applied_hub_seq")
  baselineReady  Boolean @default(false) @map("baseline_ready")
  updatedAt      String  @default("") @map("updated_at")

  @@map("sync_state")
}

model SyncImport {
  id String @id
  fingerprint String
  source String
  createdAt String @map("created_at")
  @@index([fingerprint])
  @@map("sync_imports")
}
model SyncImportArchive {
  id String @id
  source String
  tableName String @map("table_name")
  entityKey String @map("entity_key")
  payload String
  createdAt String @map("created_at")
  @@map("sync_import_archive")
}
