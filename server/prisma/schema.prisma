generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id            String   @id
  openaiBaseUrl String   @default("") @map("openai_base_url")
  openaiApiKey  String   @default("") @map("openai_api_key")
  openaiModel   String   @default("") @map("openai_model")
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")

  @@map("app_settings")
}

enum TaskStatus {
  todo
  doing
  blocked
  done
}

enum TaskPriority {
  none
  low
  medium
  high
}

model Topic {
  id            String   @id @default(cuid()) @map("id")
  name          String
  description   String   @default("")
  isExploration Boolean  @default(false) @map("is_exploration")
  goal          String     @default("")
  draftSummary  String     @default("") @map("draft_summary")
  finalSummary  String     @default("") @map("final_summary")
  summaryStatus String     @default("empty") @map("summary_status")
  summaryUpdatedAt String? @map("summary_updated_at")
  archivedAt    String?  @map("archived_at")
  revision      Int      @default(1)
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")
  tasks         Task[]
  assignmentsFrom TaskTopicAssignment[] @relation("AssignmentFromTopic")
  assignmentsTo   TaskTopicAssignment[] @relation("AssignmentToTopic")

  @@map("topics")
}

model Task {
  id            String     @id @default(cuid())
  topicId       String?    @map("topic_id")
  parentId      String?    @map("parent_id")
  sortOrder     Int        @default(0) @map("sort_order")
  revision      Int        @default(1)
  deleteBatchId String?    @map("delete_batch_id")
  title         String
  description   String     @default("")
  status        TaskStatus @default(todo)
  priority      TaskPriority @default(none)
  dueDate       String?    @map("due_date")
  resultSummary String     @default("") @map("result_summary")
  deletedAt String? @map("deleted_at")
  createdAt     String     @default("") @map("created_at")
  updatedAt     String     @default("") @map("updated_at")
  topic         Topic?     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  parent        Task?      @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children      Task[]     @relation("TaskChildren")
  tags          TaskTag[]
  topicAssignments TaskTopicAssignment[]

  @@index([topicId])
  @@index([topicId, deletedAt])
  @@index([deletedAt])
  @@index([topicId, parentId, deletedAt, sortOrder])
  @@index([parentId])
  @@index([deleteBatchId])
  @@map("tasks")
}

model Tag {
  id        String @id @default(cuid())
  name      String
  color     String @default("violet")
  revision  Int    @default(1)
  createdAt String @default("") @map("created_at")
  updatedAt String @default("") @map("updated_at")
  tasks     TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model TaskTopicAssignment {
  id             String  @id @default(cuid())
  taskId         String  @map("task_id")
  fromTopicId    String? @map("from_topic_id")
  toTopicId      String? @map("to_topic_id")
  reason         String
  source         String
  conversationId String? @map("conversation_id")
  approvalId     String? @map("approval_id")
  changedAt      String  @default("") @map("changed_at")
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromTopic      Topic?  @relation("AssignmentFromTopic", fields: [fromTopicId], references: [id], onDelete: Restrict)
  toTopic        Topic?  @relation("AssignmentToTopic", fields: [toTopicId], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
  @@index([fromTopicId])
  @@index([toTopicId])
  @@map("task_topic_assignments")
}

enum MessageRole {
  user
  assistant
  tool
  system
}

enum MessageStatus {
  streaming
  completed
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

model Conversation {
  id        String    @id @default(cuid())
  summary   String    @default("")
  summaryVersion Int   @default(0) @map("summary_version")
  lastCompactedAt String? @map("last_compacted_at")
  tokenEstimate Int   @default(0) @map("token_estimate")
  createdAt String    @default("") @map("created_at")
  updatedAt String    @default("") @map("updated_at")
  messages  Message[]
  approvals Approval[]

  @@map("conversations")
}

model ChangeRecord {
  id String @id @default(cuid())
  actorId String? @map("actor_id")
  connectionId String? @map("connection_id")
  proposalId String? @map("proposal_id")
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  operation String
  beforeSnapshot String? @map("before_snapshot")
  afterSnapshot String? @map("after_snapshot")
  source String
  conversationId String? @map("conversation_id")
  approvalId String? @map("approval_id")
  requestId String? @map("request_id")
  reversalOf String? @map("reversal_of")
  undoneAt String? @map("undone_at")
  createdAt String @default("") @map("created_at")
  @@index([entityType, entityId, createdAt])
  @@map("change_records")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  content        String
  status         MessageStatus @default(completed)
  compactedAt    String?       @map("compacted_at")
  createdAt      String       @default("") @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Approval {
  id        String         @id @default(cuid())
  conversationId String?   @map("conversation_id")
  toolName  String         @map("tool_name")
  arguments String
  status    ApprovalStatus @default(pending)
  result    String?
  createdAt String         @default("") @map("created_at")
  updatedAt String         @default("") @map("updated_at")
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("approvals")
}

model LocalSession {
  id String @id
  tokenHash String @unique
  csrfHash String
  expiresAt String
  createdAt String
}

model Connection {
  id String @id @default(cuid())
  name String
  host String
  tokenHash String @unique
  status String @default("active")
  topicIds String @default("[]")
  includeInbox Boolean @default(false)
  autoActions String @default("[]")
  revision Int @default(1)
  createdAt String
  updatedAt String
  @@index([status, createdAt])
}

model Proposal {
  id String @id @default(cuid())
  actorId String
  connectionId String?
  revision Int @default(1)
  status String @default("pending")
  commands String
  preconditions String
  preview String
  result String?
  createdAt String
  updatedAt String
  @@index([status, createdAt])
  @@index([actorId, createdAt])
}

model RequestReceipt {
  id String @id @default(cuid())
  actorId String
  requestId String
  requestHash String
  response String
  createdAt String
  @@unique([actorId, requestId])
}

model Material {
  id String @id @default(cuid())
  topicId String?
  taskId String?
  kind String
  title String
  uri String?
  revision Int @default(1)
  archivedAt String?
  createdAt String
  updatedAt String
  versions MaterialVersion[]
  @@index([topicId, archivedAt, updatedAt])
  @@index([taskId])
}
model MaterialVersion {
  id String @id @default(cuid())
  materialId String
  revision Int
  content String @default("")
  contentHash String
  metadata String @default("{}")
  attachmentPath String?
  mimeType String?
  fileName String?
  createdAt String
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@unique([materialId, revision])
}
model Memory {
  id String @id @default(cuid())
  topicId String?
  kind String
  title String
  content String
  status String @default("active")
  health String @default("current")
  importance Int @default(3)
  labels String @default("[]")
  origin String @default("manual")
  revision Int @default(1)
  evidence String @default("[]")
  createdAt String
  updatedAt String
  versions MemoryVersion[]
  @@index([topicId, status, importance, updatedAt])
}
model MemoryVersion {
  id String @id @default(cuid())
  memoryId String
  revision Int
  title String
  content String
  kind String
  status String
  health String
  evidence String
  importance Int @default(3)
  labels String @default("[]")
  origin String @default("manual")
  reason String
  createdAt String
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  @@unique([memoryId, revision])
}
model Entity {
  id String @id @default(cuid())
  topicKey String
  topicId String?
  name String
  kind String @default("concept")
  description String @default("")
  revision Int @default(1)
  createdAt String
  updatedAt String
  @@unique([topicKey, name])
  @@index([topicId, kind])
}
model GraphLink {
  id String @id @default(cuid())
  topicId String?
  fromType String
  fromId String
  toType String
  toId String
  relation String
  note String @default("")
  createdAt String
  @@unique([fromType, fromId, toType, toId, relation])
  @@index([fromId, fromType])
  @@index([toId, toType])
}
model WorkingBrief {
  id String @id @default(cuid())
  topicId String?
  content String @default("")
  manualNotes String @default("")
  manifest String @default("[]")
  revision Int @default(1)
  generatedAt String?
  updatedAt String
  @@index([topicId])
}
model OrganizationRequest {
  id String @id @default(cuid())
  topicId String?
  purpose String
  provider String
  status String @default("pending")
  snapshot String
  proposalIds String @default("[]")
  result String?
  error String?
  createdAt String
  updatedAt String
  @@index([topicId, status, createdAt])
}
model ReviewRule {
  id String @id @default(cuid())
  name String
  enabled Boolean @default(false)
  frequency String
  timeOfDay String
  timeZone String
  weekDay Int @default(0)
  topicIds String @default("[]")
  includeInbox Boolean @default(false)
  provider String @default("none")
  revision Int @default(1)
  coverageThrough String?
  createdAt String
  updatedAt String
  batches ReviewBatch[]
}
model ReviewBatch {
  id String @id @default(cuid())
  ruleId String
  occurrenceKey String
  status String @default("generating")
  snapshot String @default("{}")
  content String @default("")
  organizationIds String @default("[]")
  error String?
  createdAt String
  updatedAt String
  rule ReviewRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  @@unique([ruleId, occurrenceKey])
}

model Handoff {
  id String @id @default(cuid())
  taskId String
  status String @default("prepared")
  provider String
  mode String @default("manual")
  instruction String
  inputSnapshot String
  inputHash String
  permissions String @default("{}")
  revision Int @default(1)
  createdBy String @default("user")
  createdAt String
  updatedAt String
  runs Run[]
  reviews HandoffReview[]
  @@index([taskId, createdAt])
}
model Run {
  id String @id @default(cuid())
  handoffId String
  continuationOf String?
  status String @default("created")
  provider String
  mode String
  externalSessionId String?
  claimTokenHash String?
  claimOwner String?
  configJson String @default("{}")
  workspaceJson String @default("{}")
  resultJson String?
  error String?
  lastSequence Int @default(0)
  startedAt String?
  endedAt String?
  createdAt String
  updatedAt String
  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  events RunEvent[]
  artifacts Artifact[]
  @@index([status, createdAt])
}
model RunEvent {
  id String @id @default(cuid())
  runId String
  eventId String?
  sequence Int
  type String
  payload String
  createdAt String
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@unique([runId, sequence])
  @@unique([runId, eventId])
}
model Artifact {
  id String @id @default(cuid())
  runId String
  kind String
  name String
  content String?
  path String?
  hash String
  metadata String @default("{}")
  createdAt String
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@index([runId])
}
model HandoffReview {
  id String @id @default(cuid())
  handoffId String
  runId String
  decision String
  comment String @default("")
  taskRevision Int
  createdAt String
  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  @@index([handoffId])
}
model CodeApplication {
  id String @id @default(cuid())
  runId String
  artifactId String
  status String @default("prepared")
  targetPath String
  expectedHead String
  details String @default("{}")
  createdAt String
  updatedAt String
  @@index([runId])
}
