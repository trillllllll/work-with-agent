generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  doing
  blocked
  done
}

model Topic {
  id            String   @id @default(cuid()) @map("id")
  name          String
  description   String   @default("")
  isExploration Boolean  @default(false) @map("is_exploration")
  createdAt     String   @default("") @map("created_at")
  updatedAt     String   @default("") @map("updated_at")
  tasks         Task[]

  @@map("topics")
}

model Task {
  id            String     @id @default(cuid())
  topicId       String     @map("topic_id")
  title         String
  description   String     @default("")
  status        TaskStatus @default(todo)
  resultSummary String     @default("") @map("result_summary")
  createdAt     String     @default("") @map("created_at")
  updatedAt     String     @default("") @map("updated_at")
  topic         Topic      @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@index([topicId])
  @@map("tasks")
}

enum MessageRole {
  user
  assistant
  tool
  system
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

model Conversation {
  id        String    @id @default(cuid())
  summary   String    @default("")
  createdAt String    @default("") @map("created_at")
  updatedAt String    @default("") @map("updated_at")
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  content        String
  createdAt      String       @default("") @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Approval {
  id        String         @id @default(cuid())
  toolName  String         @map("tool_name")
  arguments String
  status    ApprovalStatus @default(pending)
  result    String?
  createdAt String         @default("") @map("created_at")
  updatedAt String         @default("") @map("updated_at")

  @@map("approvals")
}
