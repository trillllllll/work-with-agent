DATABASE_URL="file:../data/agent-studio.db"

# API listens only on 127.0.0.1. Keep this origin aligned with the browser URL.
# PORT=3016
# CLIENT_ORIGIN=http://127.0.0.1:5176,http://localhost:5176

# Optional absolute paths for managed data and executable CLI entry points.
# KNOWLEDGE_STORAGE_ROOT=D:/AgentData/knowledge-blobs
# WWA_RUNNER_DIR=D:/AgentData/runner
# WWA_CODEX_BIN=C:/path/to/codex.exe
# WWA_CLAUDE_BIN=C:/path/to/claude.exe

# Windows: unelevated is the non-admin default. Select elevated only after
# configuring that Codex sandbox backend on this machine.
# WWA_CODEX_WINDOWS_SANDBOX=unelevated
