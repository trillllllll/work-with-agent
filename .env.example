# 0.4.0 requires DOVUN_*; migrate obsolete-only configurations before startup.
DATABASE_URL="file:../data/dovun.db"

# Optional: real image search; keep this server-side. Never exposed to the client.
BRAVE_IMAGE_SEARCH_KEY=""
# Optional HTTP(S) proxy for Brave requests only. Keep proxy credentials server-side.
# For a host proxy from Docker, use http://user:password@host.docker.internal:7890
BRAVE_IMAGE_SEARCH_PROXY_URL=""
